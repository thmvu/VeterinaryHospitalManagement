@model VeterinaryHospitalManagement.Web.Areas.BackOffice.ViewModels.Visits.VisitQueueViewModel
@inject VeterinaryHospitalManagement.Web.Services.Time.IVietnamTimeProvider VietnamTimeProvider
@using Microsoft.AspNetCore.Authorization
@using VeterinaryHospitalManagement.Web.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Hàng đợi khám";
    var canWalkIn = (await AuthorizationService.AuthorizeAsync(User, PermissionPolicyName.For(PermissionCodes.VisitWalkIn))).Succeeded;
    var canCheckIn = (await AuthorizationService.AuthorizeAsync(User, PermissionPolicyName.For(PermissionCodes.VisitCheckIn))).Succeeded;
}

<header class="record-header">
    <div>
        <span class="record-kicker">Tiếp đón &amp; Hàng đợi</span>
        <h1>Hàng đợi khám bệnh</h1>
        <p>Theo dõi lượt khám đang chờ và đang thực hiện trong ngày.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="BackOffice" asp-controller="Appointments" asp-action="Index" class="btn btn-outline-brand">
            📋 Lịch hẹn
        </a>
        @if (canWalkIn)
        {
            <a asp-action="WalkIn" class="btn btn-brand">➕ Tiếp nhận vãng lai (Walk-in)</a>
        }
    </div>
</header>

@if (TempData["StatusMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<!-- Summary Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="clinical-sheet p-3 border-start border-warning border-4">
            <div class="text-muted small text-uppercase fw-bold">Chờ khám (Waiting)</div>
            <div class="d-flex align-items-baseline gap-2 mt-1">
                <span class="display-6 fw-bold text-warning">@Model.WaitingCount</span>
                <span class="text-muted">thú cưng</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="clinical-sheet p-3 border-start border-primary border-4">
            <div class="text-muted small text-uppercase fw-bold">Đang khám (In Progress)</div>
            <div class="d-flex align-items-baseline gap-2 mt-1">
                <span class="display-6 fw-bold text-primary">@Model.InProgressCount</span>
                <span class="text-muted">ca</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="clinical-sheet p-3 border-start border-success border-4">
            <div class="text-muted small text-uppercase fw-bold">Tổng đang hoạt động</div>
            <div class="d-flex align-items-baseline gap-2 mt-1">
                <span class="display-6 fw-bold text-success">@Model.TotalActiveCount</span>
                <span class="text-muted">lượt khám</span>
            </div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="clinical-sheet mb-4 p-3">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-6">
            <label asp-for="SelectedVeterinarianId" class="form-label">Lọc theo bác sĩ</label>
            <select asp-for="SelectedVeterinarianId" asp-items="Model.VeterinarianOptions" class="form-select">
                <option value="">-- Tất cả bác sĩ --</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-brand w-100">Lọc hàng đợi</button>
            <a asp-action="Index" class="btn btn-ghost">Đặt lại</a>
        </div>
    </form>
</div>

<!-- Queue Table -->
<div class="clinical-sheet p-0 overflow-hidden">
    @if (!Model.Queue.Any())
    {
        <div class="p-5 text-center text-muted">
            <div class="display-6 mb-2">🐾</div>
            <h5>Hiện tại không có thú cưng nào trong hàng đợi.</h5>
            <p class="small">Các lượt khám được tiếp nhận từ lịch hẹn hoặc khách vãng lai sẽ hiển thị tại đây.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Mã lượt khám</th>
                        <th>Thú cưng</th>
                        <th>Chủ nuôi</th>
                        <th>Bác sĩ phụ trách</th>
                        <th>Giờ tiếp nhận</th>
                        <th>Hình thức</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Queue)
                    {
                        var localTime = item.CheckedInAt.ToOffset(VietnamTimeProvider.LocalNow.Offset).DateTime;
                        <tr>
                            <td class="ps-3 font-monospace fw-semibold">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                                    @item.VisitNumber
                                </a>
                            </td>
                            <td>
                                <strong>@item.PetName</strong>
                            </td>
                            <td>
                                <div>@item.OwnerName</div>
                                <small class="text-muted">@item.OwnerPhone</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    BS. @item.VeterinarianName
                                </span>
                            </td>
                            <td>
                                @localTime.ToString("HH:mm")
                                <small class="text-muted d-block">@localTime.ToString("dd/MM/yyyy")</small>
                            </td>
                            <td>
                                @if (item.AppointmentId.HasValue)
                                {
                                    <span class="badge bg-info text-dark">Đặt trước</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Vãng lai</span>
                                }
                            </td>
                            <td>
                                @switch (item.Status)
                                {
                                    case "Waiting":
                                        <span class="badge bg-warning text-dark">Chờ khám</span>
                                        break;
                                    case "InProgress":
                                        <span class="badge bg-primary">Đang khám</span>
                                        break;
                                    case "Completed":
                                        <span class="badge bg-success">Hoàn tất</span>
                                        break;
                                    case "Cancelled":
                                        <span class="badge bg-danger">Đã hủy</span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-dark">@item.Status</span>
                                        break;
                                }
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-brand">
                                    Chi tiết →
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
