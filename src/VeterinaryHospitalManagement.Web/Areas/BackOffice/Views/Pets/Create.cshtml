@model CreatePetViewModel
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Thêm thú cưng";
    var speciesList = (ViewBag.SpeciesList as IReadOnlyList<SpeciesOption>) ?? [];
    var canViewOwners = (await AuthorizationService.AuthorizeAsync(User, PermissionPolicyName.For(PermissionCodes.OwnerView))).Succeeded;
}

<header class="record-header">
    <div>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            @if (canViewOwners) { <li class="breadcrumb-item"><a asp-area="BackOffice" asp-controller="Owners" asp-action="Index">Chủ nuôi</a></li> }
            <li class="breadcrumb-item">@Model.OwnerFullName (@Model.OwnerCode)</li>
            <li class="breadcrumb-item active" aria-current="page">Thêm thú cưng</li>
        </ol>
    </nav>
    <span class="record-kicker">Chủ nuôi @Model.OwnerCode</span><h1>Thêm thú cưng</h1>
    <p>@Model.OwnerFullName · Mã thú cưng được hệ thống cấp sau khi lưu.</p>
    </div>
</header>

<div class="clinical-sheet clinical-sheet--form"><form asp-action="Create" method="post">
    <input type="hidden" asp-for="OwnerId" />
    <input type="hidden" asp-for="OwnerCode" />
    <input type="hidden" asp-for="OwnerFullName" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label fw-bold"></label> <span class="text-danger">*</span>
        <input asp-for="Name" class="form-control" placeholder="VD: Miu Miu, Cún..." />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="SpeciesId" class="form-label fw-bold"></label> <span class="text-danger">*</span>
            <select asp-for="SpeciesId" id="speciesSelect" class="form-select">
                <option value="">-- Chọn loài --</option>
                @foreach (var species in speciesList)
                {
                    <option value="@species.Id">@species.Name (@species.Code)</option>
                }
            </select>
            <span asp-validation-for="SpeciesId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="BreedId" class="form-label fw-bold"></label>
            <select asp-for="BreedId" id="breedSelect" class="form-select">
                <option value="">-- Chọn giống (hoặc để trống) --</option>
            </select>
            <span asp-validation-for="BreedId" class="text-danger"></span>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="Sex" class="form-label fw-bold"></label> <span class="text-danger">*</span>
            <select asp-for="Sex" class="form-select">
                <option value="@PetSex.Unknown">Không xác định</option>
                <option value="@PetSex.Male">Đực</option>
                <option value="@PetSex.Female">Cái</option>
            </select>
            <span asp-validation-for="Sex" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="BirthDate" class="form-label fw-bold"></label>
            <input asp-for="BirthDate" class="form-control" type="date" max="@DateTime.UtcNow.AddHours(7).ToString("yyyy-MM-dd")" />
            <span asp-validation-for="BirthDate" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Color" class="form-label fw-bold"></label>
        <input asp-for="Color" class="form-control" placeholder="VD: Vàng trắng, Vằn xám..." />
        <span asp-validation-for="Color" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label fw-bold"></label>
        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Ghi chú về thói quen, tiền sử bệnh hoặc đặc điểm nhận dạng..."></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-brand">Lưu thú cưng</button>
        @if (canViewOwners) { <a asp-area="BackOffice" asp-controller="Owners" asp-action="Details" asp-route-id="@Model.OwnerId" class="btn btn-secondary">Hủy</a> }
        else { <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-secondary">Hủy</a> }
    </div>
</form></div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function() {
        var speciesSelect = document.getElementById("speciesSelect");
        var breedSelect = document.getElementById("breedSelect");

        speciesSelect.addEventListener("change", function() {
            var speciesId = speciesSelect.value;
            breedSelect.innerHTML = '<option value="">-- Chọn giống (hoặc để trống) --</option>';
            if (!speciesId) return;

            fetch('/BackOffice/Pets/BreedsBySpecies?speciesId=' + encodeURIComponent(speciesId))
                .then(function(response) { return response.json(); })
                .then(function(breeds) {
                    breeds.forEach(function(breed) {
                        var option = document.createElement("option");
                        option.value = breed.id;
                        option.textContent = breed.name;
                        breedSelect.appendChild(option);
                    });
                })
                .catch(function(error) { console.error('Lỗi tải danh mục giống:', error); });
        });
    });
</script>
}
