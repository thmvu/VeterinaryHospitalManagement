@model IReadOnlyList<ManagedUserSummary>
@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Quản lý tài khoản</h1>
        <p class="page-subtitle">Quản lý tài khoản nội bộ, phân vai trò và trạng thái nhân viên</p>
    </div>
    <a class="btn btn-brand" asp-action="Create" id="btn-create-user">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z"/>
        </svg>
        Tạo tài khoản
    </a>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success mb-4" role="alert">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" style="flex-shrink:0">
            <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd"/>
        </svg>
        @statusMessage
    </div>
}

<!-- Stats row -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-value">@Model.Count</div>
            <div class="stat-label">Tổng tài khoản</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-value" style="color: var(--success);">@Model.Count(u => u.IsActive)</div>
            <div class="stat-label">Đang hoạt động</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-value" style="color: var(--text-secondary);">@Model.Count(u => !u.IsActive)</div>
            <div class="stat-label">Đã khóa</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-value">@Model.Select(u => u.RoleName).Distinct().Count()</div>
            <div class="stat-label">Role hiện có</div>
        </div>
    </div>
</div>

<!-- Users Table -->
<div class="table-wrap">
    <div style="padding: 1rem 1.25rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .5rem;">
        <span style="font-weight: 600; font-size: .9375rem;">Danh sách tài khoản</span>
        <span style="font-size: .8rem; color: var(--text-secondary);">@Model.Count bản ghi</span>
    </div>
    <div class="table-responsive">
        <table class="vhm-table" aria-label="Danh sách tài khoản">
            <thead>
                <tr>
                    <th>Nhân viên</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th style="width: 80px;"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>
                        <div style="display: flex; align-items: center; gap: .75rem;">
                            <span style="width: 34px; height: 34px; border-radius: 50%; background: var(--brand-light);
                                         color: var(--brand); font-weight: 700; font-size: .8125rem;
                                         display: grid; place-items: center; flex-shrink: 0;">
                                @(user.FullName?.Length > 0 ? user.FullName[0].ToString().ToUpper() : "?")
                            </span>
                            <span style="font-weight: 600; font-size: .875rem;">@user.FullName</span>
                        </div>
                    </td>
                    <td>
                        <span style="font-size: .875rem; color: var(--text-secondary);">@user.Email</span>
                    </td>
                    <td>
                        <span class="badge @(user.RoleName switch {
                            "Admin"        => "badge-danger",
                            "Manager"      => "badge-warning",
                            "Veterinarian" => "badge-brand",
                            _              => "badge-neutral"
                        })">@user.RoleName</span>
                    </td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge badge-success">
                                <span class="dot-pulse" style="width: 5px; height: 5px;" aria-hidden="true"></span>
                                Hoạt động
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-neutral">Đã khóa</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-ghost btn-sm" asp-action="Edit" asp-route-id="@user.Id"
                           title="Quản lý @user.FullName">
                            <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path d="M2.695 14.763l-1.262 3.154a.5.5 0 0 0 .65.65l3.155-1.262a4 4 0 0 0 1.343-.885L17.5 5.5a2.121 2.121 0 0 0-3-3L3.58 13.42a4 4 0 0 0-.885 1.343Z"/>
                            </svg>
                            Quản lý
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
