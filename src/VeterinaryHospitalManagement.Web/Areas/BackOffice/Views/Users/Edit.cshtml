@model EditUserViewModel
@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<header class="record-header">
    <div>
        <span class="record-kicker">Tài khoản nhân viên</span>
        <h1>Quản lý tài khoản</h1>
        <p>@Model.FullName · @Model.Email</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
</header>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success" role="status">@statusMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<section class="clinical-sheet clinical-sheet--form" data-ui="botanical-management-form">
    <div class="sheet-heading"><div><span class="sheet-index">01</span><h2>Thông tin tài khoản</h2></div></div>
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input asp-for="Id" type="hidden" />
        <input asp-for="ConcurrencyStamp" type="hidden" />
        <input asp-for="RoleName" type="hidden" />
        <input asp-for="IsActive" type="hidden" />
        <div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
        <button type="submit" class="btn btn-brand">Lưu thông tin</button>
    </form>
</section>

<section class="clinical-sheet clinical-sheet--form">
    <div class="sheet-heading"><div><span class="sheet-index">02</span><h2>Vai trò và trạng thái</h2></div></div>
    <p>Vai trò hiện tại: <strong>@Model.RoleName</strong>. Trạng thái: <span class="status-stamp @(Model.IsActive ? "status-stamp--active" : "status-stamp--inactive")">@(Model.IsActive ? "Đang hoạt động" : "Đã khóa")</span></p>
    <form asp-action="ChangeRole" method="post" class="management-action-form">
        <input asp-for="Id" type="hidden" /><input asp-for="ConcurrencyStamp" type="hidden" />
        <div><label for="newRoleName" class="form-label">Vai trò mới</label><select id="newRoleName" name="RoleName" class="form-select"><option value="@SystemRoleNames.Receptionist">Receptionist</option><option value="@SystemRoleNames.Veterinarian">Veterinarian</option><option value="@SystemRoleNames.Manager">Manager</option><option value="@SystemRoleNames.Admin">Admin</option></select></div>
        <button type="submit" class="btn btn-outline-brand">Đổi vai trò</button>
    </form>
    <form asp-action="SetActive" method="post" class="mt-3">
        <input asp-for="Id" type="hidden" /><input asp-for="ConcurrencyStamp" type="hidden" /><input asp-for="IsActive" type="hidden" value="@(!Model.IsActive)" />
        <button type="submit" class="btn @(Model.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(Model.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")</button>
    </form>
</section>

<section class="clinical-sheet clinical-sheet--form clinical-sheet--status">
    <div class="sheet-heading"><div><span class="sheet-index">03</span><h2>Đặt lại mật khẩu</h2></div></div>
    <p class="field-guidance">Thao tác này thay mật khẩu đăng nhập của nhân viên.</p>
    <form asp-action="ResetPassword" method="post">
        <input asp-for="Id" type="hidden" /><input asp-for="ConcurrencyStamp" type="hidden" />
        <div class="mb-3"><label for="NewPassword" class="form-label">Mật khẩu mới</label><input id="NewPassword" name="NewPassword" type="password" class="form-control" autocomplete="new-password" required /></div>
        <button type="submit" class="btn btn-warning">Đặt lại mật khẩu</button>
    </form>
</section>
