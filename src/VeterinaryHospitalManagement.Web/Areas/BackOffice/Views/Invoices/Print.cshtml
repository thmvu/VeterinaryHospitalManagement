@model VeterinaryHospitalManagement.Web.Services.Billing.InvoiceDetails
@inject VeterinaryHospitalManagement.Web.Services.Time.IVietnamTimeProvider VietnamTimeProvider
@using System.Globalization
@{
    Layout = null;
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var paidAt = Model.PaidAt.ToOffset(VietnamTimeProvider.LocalNow.Offset);
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hóa đơn @Model.InvoiceNumber</title>
    <style>
        :root { color-scheme: light; }
        * { box-sizing: border-box; }
        body { margin: 0; background: #e9ede8; color: #25342b; font: 15px/1.5 Arial, sans-serif; }
        .print-actions { max-width: 820px; margin: 24px auto 12px; display: flex; justify-content: space-between; gap: 12px; }
        .print-actions a, .print-actions button { border: 1px solid #33483a; border-radius: 8px; padding: 10px 16px; background: white; color: #26382d; font: inherit; text-decoration: none; cursor: pointer; }
        .print-actions button { background: #2d3a31; color: white; }
        .invoice { max-width: 820px; margin: 0 auto 32px; padding: 44px 52px; background: white; box-shadow: 0 12px 36px #25342b18; }
        .invoice-head { display: flex; justify-content: space-between; gap: 24px; border-bottom: 2px solid #2d3a31; padding-bottom: 24px; }
        .brand { font-weight: 700; font-size: 20px; letter-spacing: .01em; }
        .brand-sub { color: #607066; font-size: 13px; }
        h1 { font-size: 25px; line-height: 1.2; margin: 0 0 8px; text-align: right; }
        .invoice-number { text-align: right; font-weight: 700; }
        .meta { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 36px; margin: 30px 0; }
        .label { display: block; color: #627166; font-size: 12px; text-transform: uppercase; letter-spacing: .08em; margin-bottom: 4px; }
        .value { font-weight: 600; }
        table { width: 100%; border-collapse: collapse; margin-top: 18px; }
        th { background: #eff3ed; text-align: left; font-size: 13px; }
        th, td { padding: 12px 10px; border-bottom: 1px solid #dce4db; vertical-align: top; }
        .number { text-align: right; white-space: nowrap; }
        .total { display: flex; justify-content: space-between; align-items: baseline; margin-top: 26px; padding-top: 18px; border-top: 2px solid #2d3a31; font-weight: 700; }
        .total strong { font-size: 24px; }
        .footer { margin-top: 40px; color: #627166; font-size: 13px; text-align: center; }
        @@media (max-width: 600px) { .invoice { padding: 28px 20px; } .invoice-head { display: block; } h1, .invoice-number { text-align: left; margin-top: 22px; } .meta { grid-template-columns: 1fr; } }
        @@media print { body { background: white; } .print-actions { display: none; } .invoice { max-width: none; margin: 0; padding: 0; box-shadow: none; } @@page { size: A4; margin: 16mm; } }
    </style>
</head>
<body>
    <div class="print-actions">
        <a asp-action="Details" asp-route-id="@Model.Id">← Quay lại hóa đơn</a>
        <button type="button" onclick="window.print()">In hóa đơn</button>
    </div>
    <main class="invoice">
        <header class="invoice-head">
            <div><div class="brand">Veterinary Hospital Management</div><div class="brand-sub">Bệnh viện thú y · Quản lý ngoại trú</div></div>
            <div><h1>HÓA ĐƠN THANH TOÁN</h1><div class="invoice-number">@Model.InvoiceNumber</div></div>
        </header>
        <section class="meta" aria-label="Thông tin hóa đơn">
            <div><span class="label">Chủ nuôi</span><span class="value">@Model.OwnerName</span><div>@Model.OwnerPhone</div></div>
            <div><span class="label">Thú cưng</span><span class="value">@Model.PetName</span></div>
            <div><span class="label">Lượt khám</span><span class="value">@Model.VisitNumber</span></div>
            <div><span class="label">Thanh toán lúc</span><span class="value">@paidAt.ToString("dd/MM/yyyy HH:mm")</span></div>
            <div><span class="label">Phương thức</span><span class="value">@(Model.PaymentMethod == VeterinaryHospitalManagement.Web.Models.Enums.PaymentMethod.Cash ? "Tiền mặt" : "Chuyển khoản")</span></div>
            <div><span class="label">Người thu</span><span class="value">@Model.ProcessedByName</span></div>
        </section>
        <table>
            <thead><tr><th>Dịch vụ</th><th class="number">Số lượng</th><th class="number">Đơn giá</th><th class="number">Thành tiền</th></tr></thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="4">Không có dịch vụ tính phí.</td></tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr><td>@item.Description</td><td class="number">@item.Quantity.ToString("0.##", vi)</td><td class="number">@item.UnitPrice.ToString("N0", vi) ₫</td><td class="number">@item.LineTotal.ToString("N0", vi) ₫</td></tr>
                    }
                }
            </tbody>
        </table>
        <div class="total"><span>Tổng đã thanh toán</span><strong>@Model.TotalAmount.ToString("N0", vi) ₫</strong></div>
        <div class="footer">Cảm ơn quý khách đã tin tưởng bệnh viện thú y.<br />Bản in từ hệ thống quản lý; không phải hóa đơn điện tử.</div>
    </main>
</body>
</html>
