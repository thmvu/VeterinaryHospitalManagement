@model VeterinaryHospitalManagement.Web.Areas.BackOffice.ViewModels.Invoices.InvoiceIndexViewModel
@inject VeterinaryHospitalManagement.Web.Services.Time.IVietnamTimeProvider VietnamTimeProvider
@{
    ViewData["Title"] = "Thanh toán & hóa đơn";
}

<header class="record-header">
    <div>
        <span class="record-kicker">Thu ngân</span>
        <h1>Thanh toán &amp; hóa đơn</h1>
        <p>Lượt khám đã hoàn tất sẽ chờ xác nhận thanh toán tại đây.</p>
    </div>
</header>

@if (TempData["StatusMessage"] is string message) { <div class="alert alert-success" role="status">@message</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }

<section class="clinical-sheet p-4 mb-4" aria-labelledby="unpaid-title">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
        <div><span class="record-kicker">Cần thu</span><h2 class="h5 mb-0" id="unpaid-title">Lượt khám chưa thanh toán</h2></div>
        <span class="badge bg-warning text-dark">@Model.Unpaid.Count lượt</span>
    </div>
    @if (Model.Unpaid.Count == 0)
    {
        <p class="text-muted mb-0">Không có lượt khám chờ thanh toán.</p>
    }
    else
    {
        <div class="table-responsive" role="region" aria-label="Lượt khám chờ thanh toán" tabindex="0">
            <table class="vhm-table">
                <thead><tr><th>Lượt khám</th><th>Thú cưng</th><th>Chủ nuôi</th><th>Hoàn tất</th><th>Tạm tính</th><th></th></tr></thead>
                <tbody>
                @foreach (var visit in Model.Unpaid)
                {
                    <tr>
                        <td><strong>@visit.VisitNumber</strong></td>
                        <td>@visit.PetName</td><td>@visit.OwnerName</td>
                        <td>@visit.CompletedAt.ToOffset(VietnamTimeProvider.LocalNow.Offset).ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@visit.TotalAmount.ToString("N0") ₫</td>
                        <td><a asp-action="Preview" asp-route-id="@visit.VisitId" class="btn btn-sm btn-outline-brand">Xem tạm tính</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="clinical-sheet p-4" aria-labelledby="recent-invoices-title">
    <span class="record-kicker">Đã thu</span>
    <h2 class="h5 border-bottom pb-3 mb-3" id="recent-invoices-title">Hóa đơn gần đây</h2>
    @if (Model.Recent.Count == 0)
    {
        <p class="text-muted mb-0">Chưa có hóa đơn.</p>
    }
    else
    {
        <div class="table-responsive" role="region" aria-label="Hóa đơn gần đây" tabindex="0">
            <table class="vhm-table">
                <thead><tr><th>Số hóa đơn</th><th>Lượt khám</th><th>Chủ nuôi</th><th>Đã thu</th><th></th></tr></thead>
                <tbody>
                @foreach (var invoice in Model.Recent)
                {
                    <tr>
                        <td><strong>@invoice.InvoiceNumber</strong></td><td>@invoice.VisitNumber</td>
                        <td>@invoice.OwnerName</td><td>@invoice.TotalAmount.ToString("N0") ₫</td>
                        <td><a asp-action="Details" asp-route-id="@invoice.Id" class="btn btn-sm btn-ghost">Xem hóa đơn</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
