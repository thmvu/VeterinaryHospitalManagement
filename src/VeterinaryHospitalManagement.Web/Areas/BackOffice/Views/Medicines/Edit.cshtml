@model VeterinaryHospitalManagement.Web.Areas.BackOffice.ViewModels.Medicines.MedicineFormViewModel
@{ViewData["Title"]="Chỉnh sửa thuốc";}
<header class="record-header"><div><span class="record-kicker">Thuốc @Model.Code</span><h1>Chỉnh sửa thuốc</h1><p>Cập nhật thông tin dùng cho đơn thuốc mới; dữ liệu lịch sử không thay đổi.</p></div><a asp-action="Index" class="btn btn-secondary">Quay lại</a></header>
@if(TempData["StatusMessage"] is string message){<div class="alert alert-success">@message</div>}@if(TempData["ErrorMessage"] is string error){<div class="alert alert-danger">@error</div>}
<div class="clinical-sheet clinical-sheet--form"><div class="d-flex justify-content-between mb-4"><div><span class="text-muted">Mã cố định</span><div><code>@Model.Code</code></div></div><span class="badge @(Model.IsActive?"badge-success":"badge-neutral")">@(Model.IsActive?"Đang dùng":"Tạm ngưng")</span></div><form method="post" asp-action="Edit"><input asp-for="Id" type="hidden"/><input asp-for="RowVersion" type="hidden"/><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="row"><div class="col-md-7 mb-3"><label asp-for="ActiveIngredient" class="form-label"></label><input asp-for="ActiveIngredient" class="form-control"/></div><div class="col-md-5 mb-3"><label asp-for="Strength" class="form-label"></label><input asp-for="Strength" class="form-control"/></div></div><div class="mb-3"><label asp-for="Unit" class="form-label"></label><input asp-for="Unit" class="form-control"/><span asp-validation-for="Unit" class="text-danger"></span></div><div class="form-actions"><button class="btn btn-brand">Lưu thay đổi</button><a asp-action="Index" class="btn btn-secondary">Hủy</a></div></form></div>
<section class="clinical-sheet clinical-sheet--status mt-4"><h2>Trạng thái sử dụng</h2><p>@(Model.IsActive?"Tạm ngưng để không cho chọn thuốc trong đơn mới.":"Mở lại để thuốc xuất hiện trong lựa chọn kê đơn.")</p><form method="post" asp-action="SetActive"><input asp-for="Id" type="hidden"/><input asp-for="RowVersion" type="hidden"/><input type="hidden" name="IsActive" value="@(!Model.IsActive?"true":"false")"/><button class="btn @(Model.IsActive?"btn-outline-danger":"btn-brand")">@(Model.IsActive?"Tạm ngưng thuốc":"Mở lại thuốc")</button></form></section>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
