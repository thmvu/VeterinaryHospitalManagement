@model VeterinaryHospitalManagement.Web.Areas.BackOffice.ViewModels.Medicines.MedicineFormViewModel
@{ViewData["Title"]="Thêm thuốc";}
<header class="record-header"><div><span class="record-kicker">Danh mục kê đơn</span><h1>Thêm thuốc</h1><p>Mã thuốc được chuẩn hóa thành chữ hoa và không đổi sau khi tạo.</p></div><a asp-action="Index" class="btn btn-secondary">Quay lại</a></header>
<div class="clinical-sheet clinical-sheet--form" data-ui="botanical-management-form"><form method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div><div class="row"><div class="col-md-5 mb-3"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" placeholder="VD: MED-AMOX"/><span asp-validation-for="Code" class="text-danger"></span></div><div class="col-md-7 mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div></div><div class="row"><div class="col-md-7 mb-3"><label asp-for="ActiveIngredient" class="form-label"></label><input asp-for="ActiveIngredient" class="form-control"/><span asp-validation-for="ActiveIngredient" class="text-danger"></span></div><div class="col-md-5 mb-3"><label asp-for="Strength" class="form-label"></label><input asp-for="Strength" class="form-control" placeholder="VD: 500 mg"/><span asp-validation-for="Strength" class="text-danger"></span></div></div><div class="mb-3"><label asp-for="Unit" class="form-label"></label><input asp-for="Unit" class="form-control" placeholder="VD: viên, ml, lọ"/><span asp-validation-for="Unit" class="text-danger"></span></div><div class="form-actions"><button class="btn btn-brand">Tạo thuốc</button><a asp-action="Index" class="btn btn-secondary">Hủy</a></div></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
