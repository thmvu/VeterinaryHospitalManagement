@model IReadOnlyList<VeterinaryHospitalManagement.Web.Services.Catalogs.MedicineListItem>
@{ViewData["Title"]="Danh mục thuốc";}
<header class="record-header"><div><span class="record-kicker">Danh mục kê đơn</span><h1>Thuốc</h1><p>Quản lý thông tin tham chiếu khi bác sĩ kê đơn; không theo dõi giá bán hoặc tồn kho.</p></div><a asp-action="Create" class="btn btn-brand">Thêm thuốc</a></header>
@if(TempData["StatusMessage"] is string message){<div class="alert alert-success" role="status">@message</div>}
@if(Model.Count==0){<section class="clinical-sheet text-center py-5"><h2>Chưa có thuốc</h2><p>Thêm thuốc đầu tiên để chuẩn bị cho quy trình kê đơn.</p><a asp-action="Create" class="btn btn-brand">Thêm thuốc đầu tiên</a></section>}
else{<div class="table-wrap"><div class="table-responsive" role="region" aria-label="Danh sách thuốc" tabindex="0"><table class="vhm-table"><thead><tr><th>Mã</th><th>Tên thuốc</th><th>Hoạt chất</th><th>Hàm lượng</th><th>Đơn vị</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><code>@x.Code</code></td><td><strong>@x.Name</strong></td><td>@(x.ActiveIngredient??"—")</td><td>@(x.Strength??"—")</td><td>@x.Unit</td><td><span class="badge @(x.IsActive?"badge-success":"badge-neutral")">@(x.IsActive?"Đang dùng":"Tạm ngưng")</span></td><td><a asp-action="Edit" asp-route-id="@x.Id" class="btn btn-ghost btn-sm">Chỉnh sửa</a></td></tr>}</tbody></table></div></div>}
