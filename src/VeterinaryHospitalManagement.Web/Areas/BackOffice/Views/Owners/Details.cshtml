@model OwnerDetails
@using Microsoft.AspNetCore.Authorization
@using VeterinaryHospitalManagement.Web.Models.Enums
@using VeterinaryHospitalManagement.Web.Services.Time
@inject IAuthorizationService AuthorizationService
@inject IVietnamTimeProvider VietnamTimeProvider
@{
    ViewData["Title"] = $"Chủ nuôi {Model.OwnerCode}";
    var canManageOwners = User.Identity?.IsAuthenticated == true &&
        (await AuthorizationService.AuthorizeAsync(User, PermissionPolicyName.For(PermissionCodes.OwnerManage))).Succeeded;
    var canManagePets = User.Identity?.IsAuthenticated == true &&
        (await AuthorizationService.AuthorizeAsync(User, PermissionPolicyName.For(PermissionCodes.PetManage))).Succeeded;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Chủ nuôi <code>@Model.OwnerCode</code></h1>
    <div>
        @if (canManageOwners)
        {
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Sửa</a>
        }
        <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Họ tên</dt>
    <dd class="col-sm-9">@Model.FullName</dd>
    <dt class="col-sm-3">Số điện thoại</dt>
    <dd class="col-sm-9">@Model.PhoneNumber</dd>
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Email) ? "—" : Model.Email)</dd>
    <dt class="col-sm-3">Địa chỉ</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Address) ? "—" : Model.Address)</dd>
    <dt class="col-sm-3">Trạng thái</dt>
    <dd class="col-sm-9">@(Model.IsActive ? "Đang hoạt động" : "Đã khóa")</dd>
    <dt class="col-sm-3">Ngày tạo</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToOffset(VietnamTimeProvider.LocalNow.Offset).ToString("dd/MM/yyyy HH:mm") (giờ Việt Nam)</dd>
</dl>

<div class="d-flex justify-content-between align-items-center mt-4 mb-2">
    <h2 class="h4 mb-0">Thú cưng (@Model.Pets.Count)</h2>
    @if (canManagePets && Model.IsActive)
    {
        <a class="btn btn-sm btn-success" asp-area="BackOffice" asp-controller="Pets" asp-action="Create" asp-route-ownerId="@Model.Id">+ Thêm thú cưng</a>
    }
</div>
@if (Model.Pets.Count == 0)
{
    <p class="text-muted">Chủ nuôi này chưa có thú cưng.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
        <tr><th>Mã thú cưng</th><th>Tên</th><th>Loài</th><th>Giống</th><th>Giới tính</th><th>Ngày sinh</th><th>Trạng thái</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var pet in Model.Pets)
        {
            <tr>
                <td><code>@pet.PetCode</code></td>
                <td class="fw-bold">@pet.Name</td>
                <td>@pet.SpeciesName</td>
                <td>@(pet.BreedName ?? "—")</td>
                <td>@(pet.Sex switch { PetSex.Male => "Đực", PetSex.Female => "Cái", _ => "Không rõ" })</td>
                <td>@(pet.BirthDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                <td>@(pet.IsActive ? "Đang hoạt động" : "Đã khóa")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-area="BackOffice" asp-controller="Pets" asp-action="Details" asp-route-id="@pet.Id">Xem</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
<p class="text-muted">Hồ sơ khám và lịch hẹn của thú cưng sẽ hiển thị ở các module sau.</p>
