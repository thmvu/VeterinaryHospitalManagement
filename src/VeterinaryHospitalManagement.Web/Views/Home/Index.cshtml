@using Microsoft.AspNetCore.Authorization
@using VeterinaryHospitalManagement.Web.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Trang chủ";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var canViewOwners = isAuthenticated && (await AuthorizationService.AuthorizeAsync(User, PermissionPolicyName.For(PermissionCodes.OwnerView))).Succeeded;
    var canManageUsers = isAuthenticated && (await AuthorizationService.AuthorizeAsync(User, PermissionPolicyName.For(PermissionCodes.UserManage))).Succeeded;
    var canManageCatalog = isAuthenticated && (await AuthorizationService.AuthorizeAsync(User, PermissionPolicyName.For(PermissionCodes.CatalogManage))).Succeeded;
    var canManageSchedule = isAuthenticated && (await AuthorizationService.AuthorizeAsync(User, PermissionPolicyName.For(PermissionCodes.ScheduleManage))).Succeeded;
}

<section class="landing-hero botanical-hero" aria-labelledby="landing-title">
    <div class="container-xxl botanical-hero__grid">
        <div class="botanical-hero__content">
            <p class="botanical-overline">Một không gian chăm sóc rõ ràng hơn</p>
            <h1 id="landing-title" class="landing-title">Quản lý bệnh viện thú y ngoại trú</h1>
            <p class="landing-lead">Hồ sơ chủ nuôi, thú cưng và đội ngũ điều trị được sắp xếp trong một nơi làm việc dịu mắt, dễ tra cứu.</p>
            <div class="botanical-hero__actions">
                @if (isAuthenticated)
                {
                    @if (canViewOwners) { <a class="btn btn-brand btn-lg" asp-area="BackOffice" asp-controller="Owners" asp-action="Index">Tra cứu chủ nuôi</a> }
                    @if (canManageUsers) { <a class="btn btn-outline-brand btn-lg" asp-area="BackOffice" asp-controller="Users" asp-action="Index">Quản lý tài khoản</a> }
                    @if (canManageCatalog) { <a class="btn btn-outline-brand btn-lg" asp-area="BackOffice" asp-controller="Veterinarians" asp-action="Index">Hồ sơ bác sĩ</a> }
                    @if (canManageSchedule) { <a class="btn btn-outline-brand btn-lg" asp-area="BackOffice" asp-controller="Schedules" asp-action="Index">Ca làm việc</a> }
                    <a class="btn btn-outline-secondary btn-lg" asp-area="" asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu</a>
                }
                else
                {
                    <a class="btn btn-brand btn-lg" asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập hệ thống</a>
                    <a class="btn btn-outline-brand btn-lg" href="#quy-trinh">Xem cách sử dụng</a>
                }
            </div>
            <p class="botanical-hero__note">Dành cho nhân viên và quản trị viên bệnh viện thú y.</p>
        </div>
        <div class="botanical-illustration" role="img" aria-label="Minh họa không gian chăm sóc thú cưng">
            <div class="botanical-illustration__arch">
                <div class="botanical-illustration__sun"></div>
                <div class="botanical-illustration__leaf botanical-illustration__leaf--left"></div>
                <div class="botanical-illustration__leaf botanical-illustration__leaf--right"></div>
                <div class="botanical-illustration__pet" aria-hidden="true">✦</div>
            </div>
            <span class="botanical-illustration__caption">Hồ sơ rõ ràng · Chăm sóc tận tâm</span>
        </div>
    </div>
</section>

<section id="dich-vu" class="landing-section" aria-labelledby="modules-title">
    <div class="container-xxl">
        <div class="section-heading">
            <p class="section-eyebrow">Các chức năng hiện có</p>
            <h2 id="modules-title" class="section-title">Nền tảng cho một ngày làm việc mạch lạc</h2>
            <p class="section-description">Bắt đầu từ các hồ sơ và quyền truy cập cần thiết. Các bước khám, kê đơn và thanh toán sẽ được bổ sung theo từng module.</p>
        </div>
        <div class="botanical-feature-grid">
            <article class="feature-card"><span class="botanical-feature-number">01</span><h3>Chủ nuôi &amp; thú cưng</h3><p>Tra cứu, tạo và cập nhật hồ sơ định danh; liên kết thú cưng với chủ nuôi.</p></article>
            <article class="feature-card"><span class="botanical-feature-number">02</span><h3>Đội ngũ bác sĩ</h3><p>Quản lý hồ sơ bác sĩ thú y và các ca làm việc đã được phân công.</p></article>
            <article class="feature-card"><span class="botanical-feature-number">03</span><h3>Tài khoản &amp; quyền</h3><p>Phân quyền truy cập theo vai trò nhân viên, phù hợp từng công việc.</p></article>
        </div>
    </div>
</section>

<section id="quy-trinh" class="landing-section landing-section--soft" aria-labelledby="workflow-title">
    <div class="container-xxl botanical-workflow">
        <div class="section-heading mb-0">
            <p class="section-eyebrow">Bắt đầu tại đây</p>
            <h2 id="workflow-title" class="section-title">Từ thông tin đến chăm sóc</h2>
        </div>
        <ol class="botanical-steps">
            <li><strong>Tìm chủ nuôi</strong><span>Tra cứu hồ sơ bằng thông tin liên hệ hoặc mã.</span></li>
            <li><strong>Xem thú cưng</strong><span>Kiểm tra danh sách thú cưng và cập nhật chi tiết cần thiết.</span></li>
            <li><strong>Phân công đội ngũ</strong><span>Quản lý hồ sơ bác sĩ và ca làm việc theo quyền được cấp.</span></li>
        </ol>
    </div>
</section>
