@using Microsoft.AspNetCore.Authorization
@using VeterinaryHospitalManagement.Web.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Trang chủ";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var canViewOwners = isAuthenticated && (await AuthorizationService.AuthorizeAsync(User, PermissionPolicyName.For(PermissionCodes.OwnerView))).Succeeded;
    var canManageUsers = isAuthenticated && (await AuthorizationService.AuthorizeAsync(User, PermissionPolicyName.For(PermissionCodes.UserManage))).Succeeded;
    var canManageCatalog = isAuthenticated && (await AuthorizationService.AuthorizeAsync(User, PermissionPolicyName.For(PermissionCodes.CatalogManage))).Succeeded;
    var canManageSchedule = isAuthenticated && (await AuthorizationService.AuthorizeAsync(User, PermissionPolicyName.For(PermissionCodes.ScheduleManage))).Succeeded;
}

<section class="landing-hero botanical-hero" aria-labelledby="landing-title">
    <div class="container-xxl botanical-hero__grid">
        <div class="botanical-hero__content">
            <div class="botanical-overline">
                <span class="live-dot" aria-hidden="true"></span>
                <span>Hệ thống quản lý ngoại trú chuẩn y khoa</span>
            </div>
            <h1 id="landing-title" class="landing-title">Quản lý bệnh viện thú y ngoại trú</h1>
            <p class="landing-lead">
                Nền tảng vận hành tập trung dành cho đội ngũ y bác sĩ và nhân sự y tế: từ điều phối lịch hẹn,
                tiếp nhận hàng đợi, ghi chép bệnh án điện tử, chỉ định điều trị đến xuất viện phí minh bạch.
            </p>
            <div class="botanical-hero__actions">
                @if (isAuthenticated)
                {
                    @if (canViewOwners) { <a class="btn btn-brand btn-lg" asp-area="BackOffice" asp-controller="Owners" asp-action="Index">Tra cứu chủ nuôi</a> }
                    @if (canManageUsers) { <a class="btn btn-outline-brand btn-lg" asp-area="BackOffice" asp-controller="Users" asp-action="Index">Quản lý tài khoản</a> }
                    @if (canManageCatalog) { <a class="btn btn-outline-brand btn-lg" asp-area="BackOffice" asp-controller="Veterinarians" asp-action="Index">Hồ sơ bác sĩ</a> }
                    @if (canManageSchedule) { <a class="btn btn-outline-brand btn-lg" asp-area="BackOffice" asp-controller="Schedules" asp-action="Index">Ca làm việc</a> }
                    <a class="btn btn-outline-secondary btn-lg" asp-area="" asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu</a>
                }
                else
                {
                    <a class="btn btn-brand btn-lg" asp-area="" asp-controller="Account" asp-action="Login">
                        <span>Đăng nhập hệ thống</span>
                        <span class="ms-1" aria-hidden="true">&rarr;</span>
                    </a>
                    <a class="btn btn-outline-brand btn-lg" href="#quy-trinh">Tìm hiểu quy trình khám</a>
                }
            </div>
            <p class="botanical-hero__note">
                <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z" clip-rule="evenodd"/></svg>
                <span>Hệ thống nội bộ được phân quyền nghiêm ngặt dành cho nhân viên bệnh viện thú y.</span>
            </p>
        </div>

        <div class="clinic-preview-card" role="region" aria-label="Bảng theo dõi ca khám thực tế">
            <div class="clinic-preview-card__header">
                <h2 class="clinic-preview-card__title">
                    <span aria-hidden="true">🩺</span>
                    <span>Quy trình khám ngoại trú</span>
                </h2>
                <span class="clinic-badge-status">
                    <span class="badge-dot" aria-hidden="true"></span>
                    Đang hoạt động
                </span>
            </div>

            <div class="preview-visit-box">
                <div class="preview-visit-row">
                    <span class="preview-visit-id">CA-2609 · NGOẠI TRÚ</span>
                    <span class="preview-visit-status">Đang khám</span>
                </div>
                <div class="preview-pet-name">Bé Bơ (Corgi Pembroke · 2 tuổi)</div>
                <div class="preview-owner-meta">Chủ nuôi: Trần Thanh Thảo · 0918 ••• 345</div>
                <div class="preview-tags">
                    <span class="preview-tag">Bác sĩ: Lê Hoàng Quân</span>
                    <span class="preview-tag">Khám tổng quát</span>
                    <span class="preview-tag">Siêu âm bụng</span>
                </div>
            </div>

            <div class="preview-stats-row">
                <div class="preview-stat">
                    <span class="preview-stat__number">4</span>
                    <span class="preview-stat__label">Bước vận hành</span>
                </div>
                <div class="preview-stat">
                    <span class="preview-stat__number">&lt; 5p</span>
                    <span class="preview-stat__label">Tiếp nhận nhanh</span>
                </div>
                <div class="preview-stat">
                    <span class="preview-stat__number">Chuẩn</span>
                    <span class="preview-stat__label">Bệnh án điện tử</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="chuc-nang" class="landing-section" aria-labelledby="modules-title">
    <div class="container-xxl">
        <div class="section-heading">
            <p class="section-eyebrow">Hệ thống phân hệ chuyên sâu</p>
            <h2 id="modules-title" class="section-title">Chuẩn hóa cho từng vị trí nghiệp vụ</h2>
            <p class="section-description">
                Được xây dựng theo quy trình khép kín của bệnh viện thú y hiện đại, đảm bảo tính liên tục giữa bàn tiếp tân,
                phòng khám lâm sàng và quầy thu ngân.
            </p>
        </div>

        <div class="modern-features-grid">
            <article class="landing-feature-card">
                <div class="landing-feature-icon-wrap" aria-hidden="true">🐾</div>
                <h3>Chủ nuôi &amp; Thú cưng</h3>
                <p>Quản lý thông tin chủ nuôi, loài, giống và hồ sơ thú cưng; tra cứu các lượt khám đã ghi nhận.</p>
                <span class="landing-feature-tag">Hồ sơ trọn đời</span>
            </article>

            <article class="landing-feature-card">
                <div class="landing-feature-icon-wrap" aria-hidden="true">📅</div>
                <h3>Lịch hẹn &amp; Ca trực</h3>
                <p>Điều phối ca khám theo khung giờ bác sĩ, hạn chế trùng lặp lịch khám và phân luồng tiếp đón thông minh.</p>
                <span class="landing-feature-tag">Chống chồng chéo</span>
            </article>

            <article class="landing-feature-card">
                <div class="landing-feature-icon-wrap" aria-hidden="true">🩺</div>
                <h3>Tiếp nhận &amp; Hàng đợi</h3>
                <p>Tiếp nhận bệnh nhân hẹn trước hoặc walk-in, chuyển trạng thái linh hoạt và cấp số thứ tự vào phòng khám.</p>
                <span class="landing-feature-tag">Lịch theo ca bác sĩ</span>
            </article>

            <article class="landing-feature-card">
                <div class="landing-feature-icon-wrap" aria-hidden="true">📋</div>
                <h3>Bệnh án lâm sàng</h3>
                <p>Ghi nhận triệu chứng, chẩn đoán, cân nặng và chỉ số sinh tồn; hồ sơ được chốt khi bác sĩ hoàn tất lượt khám.</p>
                <span class="landing-feature-tag">Bảo mật bệnh án</span>
            </article>

            <article class="landing-feature-card">
                <div class="landing-feature-icon-wrap" aria-hidden="true">💊</div>
                <h3>Chỉ định &amp; Đơn thuốc</h3>
                <p>Chỉ định dịch vụ xét nghiệm, kê đơn thuốc ngoại trú kèm hướng dẫn liều dùng chi tiết cho chủ nuôi mang về.</p>
                <span class="landing-feature-tag">Minh bạch điều trị</span>
            </article>

            <article class="landing-feature-card">
                <div class="landing-feature-icon-wrap" aria-hidden="true">🧾</div>
                <h3>Viện phí &amp; Báo cáo</h3>
                <p>Tính toán viện phí tự động từ dịch vụ thực tế, xuất hóa đơn một lần và kết xuất báo cáo doanh thu Excel.</p>
                <span class="landing-feature-tag">Định dạng ClosedXML</span>
            </article>
        </div>
    </div>
</section>

<section id="quy-trinh" class="landing-section landing-section--soft" aria-labelledby="workflow-title">
    <div class="container-xxl">
        <div class="section-heading">
            <p class="section-eyebrow">Quy trình vận hành</p>
            <h2 id="workflow-title" class="section-title">4 Bước khám chữa bệnh ngoại trú</h2>
            <p class="section-description">
                Đơn giản hóa tương tác, giảm thiểu thời gian chờ đợi của thú cưng và đảm bảo dữ liệu luôn toàn vẹn.
            </p>
        </div>

        <div class="workflow-steps-grid">
            <div class="workflow-step-card">
                <div class="workflow-step-badge">01</div>
                <h3>Tiếp đón &amp; Phân luồng</h3>
                <p>Lễ tân kiểm tra thông tin chủ nuôi qua số điện thoại, tiếp nhận ca hẹn hoặc khách vãng lai vào hàng đợi.</p>
            </div>

            <div class="workflow-step-card">
                <div class="workflow-step-badge">02</div>
                <h3>Khám bệnh &amp; Chẩn đoán</h3>
                <p>Bác sĩ mở ca khám được chỉ định, kiểm tra lâm sàng và tạo bệnh án điện tử với quyền riêng tư được kiểm soát.</p>
            </div>

            <div class="workflow-step-card">
                <div class="workflow-step-badge">03</div>
                <h3>Kê đơn &amp; Dịch vụ</h3>
                <p>Bác sĩ thực hiện kỹ thuật điều trị, kê toa thuốc và hoàn tất hồ sơ lượt khám trong phiên làm việc an toàn.</p>
            </div>

            <div class="workflow-step-card">
                <div class="workflow-step-badge">04</div>
                <h3>Thanh toán &amp; Hóa đơn</h3>
                <p>Thu ngân đối soát viện phí đúng các dịch vụ đã thực hiện, thu tiền một lần và in hóa đơn trao tay chủ nuôi.</p>
            </div>
        </div>

        <div class="trust-callout">
            <h3>Bảo mật &amp; Truy vết Kiểm toán Toàn trình</h3>
            <p>
                Mọi tác vụ từ đăng nhập, đổi phân quyền, cập nhật bệnh án đến lập hóa đơn đều được lưu vết kiểm toán (Audit Log)
                tự động với cơ chế kiểm soát giao dịch Serializable ngắn hạn, chống xung đột dữ liệu đồng thời.
            </p>
            <div class="trust-pills">
                <span class="trust-pill">🛡️ Phân quyền 4 vai trò</span>
                <span class="trust-pill">🔒 Kiểm soát chống xung đột RowVersion</span>
                <span class="trust-pill">📜 Nhật ký kiểm toán bất biến</span>
                <span class="trust-pill">⏰ Chuẩn thời gian Asia/Ho_Chi_Minh</span>
            </div>
        </div>
    </div>
</section>
